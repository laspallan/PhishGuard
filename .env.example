# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
PHISHGUARD_ENVIRONMENT=development

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me

# --- Encryption of email addresses at rest ---
# Generate your own values (from backend/, with the venv active):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
# Losing PHISHGUARD_ENCRYPTION_KEY makes stored emails unreadable; back it up safely.
PHISHGUARD_ENCRYPTION_KEY=
PHISHGUARD_EMAIL_HASH_KEY=

# --- Threat Intelligence (Phase 4) ---
# Free tier keys; never commit real values.
PHISHGUARD_VIRUSTOTAL_API_KEY=
PHISHGUARD_ALIENVAULT_OTX_API_KEY=
# Optional: force offline/mock mode in dev (true/false)
PHISHGUARD_TI_OFFLINE=false
# Inside Docker, docker-compose.yml sets these to the container hostnames.
PHISHGUARD_DATABASE_URL=postgresql+psycopg://phishguard:change-me@127.0.0.1:5432/phishguard
PHISHGUARD_REDIS_URL=redis://127.0.0.1:6379/0
