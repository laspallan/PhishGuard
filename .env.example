# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
PHISHGUARD_ENVIRONMENT=development

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me

# --- Used when running the API outside Docker ---
# Inside Docker, docker-compose.yml sets these to the container hostnames.
PHISHGUARD_DATABASE_URL=postgresql+psycopg://phishguard:change-me@localhost:5432/phishguard
PHISHGUARD_REDIS_URL=redis://localhost:6379/0
