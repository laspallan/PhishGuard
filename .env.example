# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
PHISHGUARD_ENVIRONMENT=development
# Shared secret the extension, gateway and dashboard send in the X-API-Key header.
# Required outside development (without it the protected endpoints answer 503).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PHISHGUARD_API_KEY=
# Where the dashboard is opened from (browser CORS check). Default: the Vite dev server.
# PHISHGUARD_DASHBOARD_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Data folder (models/, ti_responses/); defaults to the repo-root data/ folder.
# PHISHGUARD_DATA_DIR=

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me

# --- Encryption of email addresses at rest ---
# Generate your own values (from backend/, with the venv active):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
# Losing PHISHGUARD_ENCRYPTION_KEY makes stored emails unreadable; back it up safely.
PHISHGUARD_ENCRYPTION_KEY=
PHISHGUARD_EMAIL_HASH_KEY=

# --- Data collection (Phase 1) ---
# Optional PhishTank application key (without it: "a few downloads per day") and your
# PhishTank username, used in the User-Agent "phishtank/<username>" that PhishTank asks for.
PHISHGUARD_PHISHTANK_APP_KEY=
PHISHGUARD_PHISHTANK_USERNAME=

# --- Threat intelligence (Phase 4) ---
# Free-tier keys; never commit real values. VirusTotal public API: 4 requests/min, 500/day.
PHISHGUARD_VIRUSTOTAL_API_KEY=
PHISHGUARD_ALIENVAULT_OTX_API_KEY=
# true = no threat-intelligence lookups at all (ti_score is then "unknown")
PHISHGUARD_TI_OFFLINE=false

# --- Live URL scans (Phase 5) ---
# Stage 1 probabilities inside this band fetch the page. Provisional until M1 is trained.
PHISHGUARD_STAGE1_BAND_LOW=0.15
PHISHGUARD_STAGE1_BAND_HIGH=0.85
# URL scans per API key per minute (0 = no limit)
PHISHGUARD_SCAN_RATE_LIMIT_PER_MINUTE=60

# --- Used when running the API outside Docker ---
# Inside Docker, docker-compose.yml sets these to the container hostnames.
PHISHGUARD_DATABASE_URL=postgresql+psycopg://phishguard:change-me@127.0.0.1:5432/phishguard
# Redis is published on the host only with docker-compose.dev.yml (see that file).
PHISHGUARD_REDIS_URL=redis://127.0.0.1:6379/0

# Simulations (Phase 6). Leave PHISHGUARD_ETHICS_APPROVAL_REF empty until the university approves:
# no campaign can launch without it. GoPhish runs with `docker compose --profile simulate up`.
PHISHGUARD_GOPHISH_URL=https://127.0.0.1:3333
PHISHGUARD_GOPHISH_API_KEY=
# The certificate made by `make gophish-cert` (GoPhish's own one cannot be checked). Relative to
# backend/, where the API is started; docker compose sets its own path for the api container.
PHISHGUARD_GOPHISH_CA_FILE=../data/gophish/cert/gophish_admin.crt
PHISHGUARD_ETHICS_APPROVAL_REF=
# Shown on the explanation page every simulation link leads to (questions and withdrawal).
PHISHGUARD_SIMULATION_CONTACT_EMAIL=
